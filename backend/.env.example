# Copy this file to .env (same folder) and fill in what you use.
# Restart the server after changing it.

# ---------- Translation: at least ONE key is required ----------
# auto = use the first key found, in this order: Anthropic, Gemini, OpenAI
TRANSLATE_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Used automatically while GEMINI_MODEL is overloaded or too slow (leave empty to turn off)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# How many batches of 20 lines are translated at the same time (lower it if you hit rate limits)
TRANSLATE_WORKERS=4

# ---------- Speech-to-text ----------
# local  = faster-whisper on this computer (free; downloads the model on first use)
# openai = OpenAI Whisper API (uses OPENAI_API_KEY)
TRANSCRIBE_PROVIDER=local
# tiny / base / small (fast) / medium / large-v3-turbo (best quality, slower)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ---------- Khmer voice (text-to-speech) ----------
# edge   = Microsoft Edge voices — free, no key, needs internet (Piseth ♂ / Sreymom ♀)
# azure  = Azure AI Speech — official & paid, same voices (needs key + region)
# google = Google Cloud TTS — only works if Google offers a km-KH voice to your account
# mms    = Meta MMS-TTS — free & offline, one voice (pip install -r requirements-extra.txt)
TTS_PROVIDER=edge
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
GOOGLE_TTS_API_KEY=
MMS_MODEL=facebook/mms-tts-khm

# ---------- Other ----------
MAX_UPLOAD_MB=500
# Delete projects that haven't been opened or edited for this many hours (0 = keep until you delete them)
PROJECT_TTL_HOURS=0
# How many exports keep their video files (older versions keep only their edits)
KEEP_VERSIONS=5
# Default volume of the original audio in the "keep original quietly" mode (0–1); changeable per project
DUCK_VOLUME=0.15
# Voice clips generated at the same time
TTS_WORKERS=4
# Where voice removal (Demucs) runs: auto picks the Apple / NVIDIA GPU when there is one
DEMUCS_DEVICE=auto
# Leave empty to find ffmpeg/ffprobe on your PATH
FFMPEG_PATH=
FFPROBE_PATH=
HOST=127.0.0.1
PORT=8000
