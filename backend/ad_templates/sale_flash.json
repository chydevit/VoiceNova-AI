{
 "version": 1,
 "id": "sale_flash",
 "name": "Flash sale",
 "km": "ប្រូម៉ូសិនក្ដៅៗ",
 "style": "sale",
 "about": "Fast punch-in zooms and flash cuts, a big price tag and a discount burst.",
 "fonts": {
  "title": "Koulen",
  "body": "Kantumruy Pro"
 },
 "palette": "brand",
 "shots": {
  "fit": "fill",
  "motion": [
   "zoom_in",
   "zoom_in",
   "pan_right"
  ],
  "motion_amount": 0.15,
  "transition": {
   "type": "flash",
   "duration": 0.2
  }
 },
 "captions": {
  "default": {
   "preset": "highlight",
   "position": "lower",
   "anim": "pop",
   "size": 1.0
  },
  "hook": {
   "preset": "headline",
   "position": "center",
   "anim": "pop",
   "size": 1.3
  },
  "price": {
   "preset": "price_tag",
   "position": "center",
   "anim": "pop",
   "size": 1.4
  },
  "promo": {
   "preset": "burst",
   "position": "upper",
   "anim": "pop",
   "size": 1.3
  },
  "cta": {
   "preset": "button",
   "position": "lower",
   "anim": "pop",
   "size": 1.0
  }
 },
 "logo": {
  "corner": "top_left",
  "size": 0.13,
  "opacity": 0.95
 },
 "sponsored": {
  "show": false,
  "corner": "top_right"
 },
 "end_screen": {
  "layout": "card",
  "background": "brand",
  "seconds": 3.0,
  "anim": "pop",
  "show": [
   "logo",
   "headline",
   "price",
   "promo",
   "cta",
   "contact"
  ]
 },
 "music": {
  "mood": "upbeat",
  "volume": 0.4,
  "duck": 0.3
 },
 "voice": {
  "speed": 1.1
 }
}
